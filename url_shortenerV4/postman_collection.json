{
  "info": {
    "name": "URL Shortener V4 - Polyglot Persistence Migration Tests",
    "description": "Complete API test suite for validating the DynamoDB migration. All 17 endpoints covered.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8080"},
    {"key": "jwtToken", "value": ""},
    {"key": "refreshToken", "value": ""},
    {"key": "shortUrl", "value": ""},
    {"key": "urlId", "value": ""},
    {"key": "testUsername", "value": "testuser_dynamodb"},
    {"key": "testEmail", "value": "testuser_dynamodb@example.com"},
    {"key": "testPassword", "value": "TestPass123!"}
  ],
  "item": [
    {
      "name": "1. Health Check",
      "item": [
        {
          "name": "GET Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has success message', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.status).to.eql(200);",
                  "  pm.expect(json.message).to.include('up');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {"raw": "{{baseUrl}}/api/v1/health", "host": ["{{baseUrl}}"], "path": ["api", "v1", "health"]}
          }
        }
      ]
    },
    {
      "name": "2. Authentication",
      "item": [
        {
          "name": "POST Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Registration success message', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.status).to.eql(200);",
                  "  pm.expect(json.message).to.include('registered');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"{{testUsername}}\",\"email\":\"{{testEmail}}\",\"password\":\"{{testPassword}}\"}"
            },
            "url": {"raw": "{{baseUrl}}/api/v1/auth/public/register", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "public", "register"]}
          }
        },
        {
          "name": "POST Register - Duplicate (expect 409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 409 Conflict', () => pm.response.to.have.status(409));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"{{testUsername}}\",\"email\":\"{{testEmail}}\",\"password\":\"{{testPassword}}\"}"
            },
            "url": {"raw": "{{baseUrl}}/api/v1/auth/public/register", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "public", "register"]}
          }
        },
        {
          "name": "POST Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response contains token and refreshToken', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data.token).to.be.a('string');",
                  "  pm.expect(json.data.refreshToken).to.be.a('string');",
                  "  pm.environment.set('jwtToken', json.data.token);",
                  "  pm.environment.set('refreshToken', json.data.refreshToken);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"{{testUsername}}\",\"password\":\"{{testPassword}}\"}"
            },
            "url": {"raw": "{{baseUrl}}/api/v1/auth/public/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "public", "login"]}
          }
        },
        {
          "name": "POST Login - Bad Credentials (expect 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"{{testUsername}}\",\"password\":\"WrongPassword123!\"}"
            },
            "url": {"raw": "{{baseUrl}}/api/v1/auth/public/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "public", "login"]}
          }
        },
        {
          "name": "GET Me (Profile)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Profile has correct username', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data.username).to.eql(pm.environment.get('testUsername'));",
                  "  pm.expect(json.data.email).to.eql(pm.environment.get('testEmail'));",
                  "  pm.expect(json.data.roles).to.include('ROLE_USER');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{jwtToken}}"}],
            "url": {"raw": "{{baseUrl}}/api/v1/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "me"]}
          }
        },
        {
          "name": "POST Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('New tokens returned', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data.token).to.be.a('string');",
                  "  pm.expect(json.data.refreshToken).to.be.a('string');",
                  "  pm.environment.set('jwtToken', json.data.token);",
                  "  pm.environment.set('refreshToken', json.data.refreshToken);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"refreshToken\":\"{{refreshToken}}\"}"
            },
            "url": {"raw": "{{baseUrl}}/api/v1/auth/public/refresh", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "public", "refresh"]}
          }
        }
      ]
    },
    {
      "name": "3. URL Shortening (CRUD)",
      "item": [
        {
          "name": "POST Create Short URL",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('URL created with all fields', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data.shortUrl).to.be.a('string').with.lengthOf(8);",
                  "  pm.expect(json.data.originalUrl).to.eql('https://example.com/test-page');",
                  "  pm.expect(json.data.clickCount).to.eql(0);",
                  "  pm.expect(json.data.username).to.eql(pm.environment.get('testUsername'));",
                  "  pm.expect(json.data.id).to.be.a('number');",
                  "  pm.environment.set('shortUrl', json.data.shortUrl);",
                  "  pm.environment.set('urlId', json.data.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{jwtToken}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"originalUrl\":\"https://example.com/test-page\"}"
            },
            "url": {"raw": "{{baseUrl}}/api/v1/urls/shorten", "host": ["{{baseUrl}}"], "path": ["api", "v1", "urls", "shorten"]}
          }
        },
        {
          "name": "POST Create Duplicate URL (same user)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns existing URL', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data.shortUrl).to.eql(pm.environment.get('shortUrl'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{jwtToken}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"originalUrl\":\"https://example.com/test-page\"}"
            },
            "url": {"raw": "{{baseUrl}}/api/v1/urls/shorten", "host": ["{{baseUrl}}"], "path": ["api", "v1", "urls", "shorten"]}
          }
        },
        {
          "name": "GET My URLs",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns paginated URLs', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data.content).to.be.an('array');",
                  "  pm.expect(json.data.content.length).to.be.greaterThan(0);",
                  "  pm.expect(json.data.content[0].shortUrl).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{jwtToken}}"}],
            "url": {"raw": "{{baseUrl}}/api/v1/urls/myurls?page=0&size=10&sort=createdDate,desc", "host": ["{{baseUrl}}"], "path": ["api", "v1", "urls", "myurls"], "query": [
              {"key": "page", "value": "0"}, {"key": "size", "value": "10"}, {"key": "sort", "value": "createdDate,desc"}
            ]}
          }
        },
        {
          "name": "GET URL By ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns correct URL', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data.id).to.eql(pm.environment.get('urlId'));",
                  "  pm.expect(json.data.shortUrl).to.eql(pm.environment.get('shortUrl'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{jwtToken}}"}],
            "url": {"raw": "{{baseUrl}}/api/v1/urls/{{urlId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "urls", "{{urlId}}"]}
          }
        },
        {
          "name": "PATCH Update URL",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('URL updated', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data.originalUrl).to.eql('https://example.com/updated-page');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{jwtToken}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"originalUrl\":\"https://example.com/updated-page\"}"
            },
            "url": {"raw": "{{baseUrl}}/api/v1/urls/{{urlId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "urls", "{{urlId}}"]}
          }
        }
      ]
    },
    {
      "name": "4. Redirect & Click Tracking",
      "item": [
        {
          "name": "GET Redirect (multiple times to test clickCount)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 302', () => pm.response.to.have.status(302));",
                  "pm.test('Location header points to original URL', () => {",
                  "  pm.expect(pm.response.headers.get('Location')).to.include('example.com');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {"raw": "{{baseUrl}}/shortUrl?shortUrl={{shortUrl}}", "host": ["{{baseUrl}}"], "path": ["shortUrl"], "query": [{"key": "shortUrl", "value": "{{shortUrl}}"}]}
          }
        }
      ]
    },
    {
      "name": "5. Analytics & Dashboard",
      "item": [
        {
          "name": "GET URL Analytics",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns click event data', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{jwtToken}}"}],
            "url": {
              "raw": "{{baseUrl}}/api/v1/urls/analytics?shortUrl={{shortUrl}}&startDate=2020-01-01T00:00:00&endDate=2030-12-31T23:59:59",
              "host": ["{{baseUrl}}"], "path": ["api", "v1", "urls", "analytics"],
              "query": [
                {"key": "shortUrl", "value": "{{shortUrl}}"},
                {"key": "startDate", "value": "2020-01-01T00:00:00"},
                {"key": "endDate", "value": "2030-12-31T23:59:59"}
              ]
            }
          }
        },
        {
          "name": "GET Analytics Details",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns detailed click events', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data).to.be.an('array');",
                  "  if (json.data.length > 0) {",
                  "    pm.expect(json.data[0].ipAddress).to.be.a('string');",
                  "    pm.expect(json.data[0].userAgent).to.be.a('string');",
                  "  }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{jwtToken}}"}],
            "url": {
              "raw": "{{baseUrl}}/api/v1/urls/analytics/{{shortUrl}}/details?startDate=2020-01-01T00:00:00&endDate=2030-12-31T23:59:59",
              "host": ["{{baseUrl}}"], "path": ["api", "v1", "urls", "analytics", "{{shortUrl}}", "details"],
              "query": [
                {"key": "startDate", "value": "2020-01-01T00:00:00"},
                {"key": "endDate", "value": "2030-12-31T23:59:59"}
              ]
            }
          }
        },
        {
          "name": "GET Total Clicks",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns total clicks array', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{jwtToken}}"}],
            "url": {
              "raw": "{{baseUrl}}/api/v1/urls/totalClicks?startDate=2020-01-01&endDate=2030-12-31",
              "host": ["{{baseUrl}}"], "path": ["api", "v1", "urls", "totalClicks"],
              "query": [{"key": "startDate", "value": "2020-01-01"}, {"key": "endDate", "value": "2030-12-31"}]
            }
          }
        },
        {
          "name": "GET Top URLs",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns top URLs array', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{jwtToken}}"}],
            "url": {
              "raw": "{{baseUrl}}/api/v1/urls/top?limit=10",
              "host": ["{{baseUrl}}"], "path": ["api", "v1", "urls", "top"],
              "query": [{"key": "limit", "value": "10"}]
            }
          }
        },
        {
          "name": "GET Dashboard",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Dashboard has all fields', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data.totalUrls).to.be.a('number');",
                  "  pm.expect(json.data.totalClicks).to.be.a('number');",
                  "  pm.expect(json.data.clicksToday).to.be.a('number');",
                  "  pm.expect(json.data.clicksThisWeek).to.be.a('number');",
                  "  pm.expect(json.data.topUrls).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{jwtToken}}"}],
            "url": {"raw": "{{baseUrl}}/api/v1/urls/dashboard", "host": ["{{baseUrl}}"], "path": ["api", "v1", "urls", "dashboard"]}
          }
        }
      ]
    },
    {
      "name": "6. Cleanup",
      "item": [
        {
          "name": "DELETE URL",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('URL deleted', () => {",
                  "  pm.expect(pm.response.json().message).to.include('deleted');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [{"key": "Authorization", "value": "Bearer {{jwtToken}}"}],
            "url": {"raw": "{{baseUrl}}/api/v1/urls/{{urlId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "urls", "{{urlId}}"]}
          }
        },
        {
          "name": "POST Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{jwtToken}}"}],
            "url": {"raw": "{{baseUrl}}/api/v1/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "logout"]}
          }
        }
      ]
    }
  ]
}
