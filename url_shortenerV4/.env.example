# Copy to .env and fill in the values. Never commit .env.

# Host port for the app. The frontend expects 8080; change it only if 8080 is taken.
# APP_PORT=8080

POSTGRES_DB=urlshortener
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/urlshortener
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me

# Base64-encoded key of at least 256 bits. Generate with: openssl rand -base64 32
JWT_SECRET=

# Salt for hashing client IPs in analytics. Generate with: openssl rand -base64 32
ANALYTICS_IP_SALT=

# Lets signed-in users switch their own plan without paying (for trying out
# the plan rules until payments exist). Never set to true in production.
DEV_PLAN_SWITCH_ENABLED=false

# ============================================================
# POLYGLOT PERSISTENCE: DynamoDB Local
# ============================================================
DYNAMODB_ENDPOINT=http://dynamodb:8000
AWS_ACCESS_KEY_ID=dummy
AWS_SECRET_ACCESS_KEY=dummy
AWS_REGION=us-east-1
