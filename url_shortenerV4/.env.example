# Copy to .env and fill in the values. Never commit .env.

# Host port for the app. The frontend expects 8080; change it only if 8080 is taken.
# APP_PORT=8080

POSTGRES_DB=urlshortener
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/urlshortener
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me

# Base64-encoded key of at least 256 bits. Generate with: openssl rand -base64 32
JWT_SECRET=

# Salt for hashing client IPs in analytics. Generate with: openssl rand -base64 32
ANALYTICS_IP_SALT=

# Lets signed-in users switch their own plan without paying (for trying out
# the plan rules until payments exist). Never set to true in production.
DEV_PLAN_SWITCH_ENABLED=false

# Sign in with Google / GitHub (optional). See docs/oauth-setup.md.
# Leave empty to hide that sign-in button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Payments through Razorpay (optional). See docs/razorpay-setup.md.
# Leave empty to keep payments off.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Prices in paise (9900 = ₹99) and when reminder emails go out (daily 09:00).
# BILLING_MONTHLY_PRICE_PAISE=9900
# BILLING_YEARLY_PRICE_PAISE=99900
# BILLING_REMINDERS_CRON=0 0 9 * * *
# Where "Pay now" links in emails point.
# FRONTEND_URL=http://localhost:4200

# Outgoing email for payment reminders. Defaults to the Mailpit container
# (view at http://localhost:8025). For real email, set an SMTP server:
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# MAIL_FROM=ShortLink <no-reply@yourdomain.com>

# ============================================================
# POLYGLOT PERSISTENCE: DynamoDB Local
# ============================================================
DYNAMODB_ENDPOINT=http://dynamodb:8000
AWS_ACCESS_KEY_ID=dummy
AWS_SECRET_ACCESS_KEY=dummy
AWS_REGION=us-east-1
