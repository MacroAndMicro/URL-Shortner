    {
      "id": 7,
      "type": "stat",
      "title": "Circuit breakers",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "description": "Current state of each circuit breaker. Open: calls to that service fail at once while it is down. Half-open: trying a few calls to see if it is back.",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "2 * max by (name) (resilience4j_circuitbreaker_state{state=\"open\"}) + max by (name) (resilience4j_circuitbreaker_state{state=\"half_open\"})",
          "legendFormat": "{{name}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Closed",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "Half-open",
                  "color": "orange",
                  "index": 1
                },
                "2": {
                  "text": "Open",
                  "color": "red",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Circuit breaker failure rate",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "description": "Share of recent calls to each service that failed. A breaker opens at 50%. -1 means too few calls yet to judge.",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "expr": "resilience4j_circuitbreaker_failure_rate",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      }
    }
